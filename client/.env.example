# .env.example

# Proxy do Vite (apenas desenvolvimento)
# O frontend deve chamar a API via "/api" (mesma origem).
# Em DEV, o Vite proxy encaminha "/api" para o backend.
VITE_PROXY_TARGET=http://localhost:3013
# Prefixo de deploy do frontend (usado no build de produção, ver .env.production).
# "/" para a raiz do host, "/sap/" quando servido em subcaminho por proxy reverso.
VITE_BASE_PATH=/
