# .env.production
#
# Lido automaticamente pelo `vite build`.
#
# Prefixo em que o frontend é servido. Deixe "/" se o SAP responde na raiz do
# host; use "/sap/" (com as duas barras) quando ele está atrás de um proxy
# reverso em subcaminho, ex.: http://10.25.160.49/sap/.
#
# Vale para os assets, para as rotas do React Router e para a baseURL da API.
VITE_BASE_PATH=/sap/
